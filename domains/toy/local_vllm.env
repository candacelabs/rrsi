# Every role on one local OpenAI-compatible engine (for example vLLM).
export RRSI_LLM_BACKEND=openai RRSI_POLICY_BACKEND=openai
export RRSI_OPENAI_BASE_URL=${RRSI_OPENAI_BASE_URL:-http://127.0.0.1:8000/v1}   # set to your vLLM host
export RRSI_OPENAI_MODEL=Qwen/Qwen3-4B-Instruct-2507-FP8
export RRSI_POLICY_MODEL=$RRSI_OPENAI_MODEL
# 24K-token context: ~60K characters of prompt leaves room for the reply.
export RRSI_OPENAI_MAX_PROMPT_CHARS=60000
